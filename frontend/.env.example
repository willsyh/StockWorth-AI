# StockWorth AI — frontend environment. Copy to frontend/.env.local and fill in.
# Only VITE_* variables are exposed to the browser. Never put service-role keys
# or AI provider keys here.

VITE_API_BASE_URL=http://localhost:8000

# Optional. Leave both empty for local mode (no login, backend uses SQLite).
# Must match the backend: set both here and in backend/.env, or neither.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
