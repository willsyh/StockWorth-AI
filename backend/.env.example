# StockWorth AI — backend environment. Copy to backend/.env and fill in.
# Never commit a real .env file.

# development | production. In production, the local SQLite fallback is disabled
# and /docs is hidden.
APP_ENV=development

# Comma-separated allowlist of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (optional for local development) ---------------------------------
# When both are set, analyses are stored in Supabase and every private endpoint
# requires a Supabase access token. The backend forwards the user's token to
# PostgREST, so Row Level Security applies. No service-role key is needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used only when Supabase is not configured (development only).
# LOCAL_DB_PATH=./data/stockworth_local.db

# --- AI provider (optional) ----------------------------------------------------
# AI_PROVIDER: anthropic | gemini. Leave the selected provider's key empty to use
# deterministic rule-based insights only. Keys stay on the server; never put them in frontend/.env.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Empty = provider default (anthropic: claude-opus-5-5, gemini: gemini-3.5-flash).
AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_RATE_LIMIT_PER_HOUR=10

# --- Market data / share prices (optional) -----------------------------------------
# Enables the "Ambil harga" button. Only IDX listings (TICKER.JK, IDR) are accepted;
# if the provider has no BEI data the app says so and the price stays manual.
# Note: the Alpha Vantage free tier (25 requests/day) currently returns no .JK data.
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=
MARKET_CACHE_SECONDS=900
MARKET_RATE_LIMIT_PER_HOUR=20

# Max upload size for CSV/XLSX import, in bytes (default 2 MB).
MAX_UPLOAD_BYTES=2097152

# Optional JSON file overriding scoring weights/thresholds (see app/services/scoring_config.py).
# SCORING_CONFIG_PATH=./scoring.json
