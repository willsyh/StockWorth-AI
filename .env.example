# StockWorth AI uses one env file per app:
#   backend/.env        (template: backend/.env.example)  — secrets live here only
#   frontend/.env.local (template: frontend/.env.example) — public VITE_* values only
#
# Summary of variables:
#   backend:  APP_ENV, CORS_ORIGINS, SUPABASE_URL, SUPABASE_ANON_KEY, ANTHROPIC_API_KEY,
#             AI_MODEL, AI_RATE_LIMIT_PER_HOUR, MAX_UPLOAD_BYTES, SCORING_CONFIG_PATH
#   frontend: VITE_API_BASE_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
